# AITable API token (server-side only)
AITABLE_API_TOKEN=your_aitable_api_token

# AITable default space ID (client & server)
AITABLE_DEFAULT_SPACE_ID=your_aitable_space_id

# Logging configuration
DEBUG_LOGS=true # Set to 'false' to disable extensive logging
LOG_LEVEL=debug # options: debug, info, warn, error

# Authentication (server-side only)
# Format: username:passwordHash,role;username2:passwordHash2,role2
# Roles: CEO, CFO, SalesManager, PM
USER_CREDENTIALS=admin:$2a$10$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX,CEO;finance:$2a$10$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX,CFO

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100 # Max requests per window 